extends "res://tests/combat_feel.gd"
const ViewModel = preload("res://scripts/frontend/rpg_view_model.gd")
const Preferences = preload("res://rpg/game_preferences.gd")

func _initialize() -> void:
	Preferences.settings_path = OS.get_temp_dir().path_join("mosslight-unified-energy-%d-%d.cfg" % [OS.get_process_id(), Time.get_ticks_usec()])
	call_deferred("run")

func run() -> void:
	arena = load("res://scenes/demo/CombatTestArena.tscn").instantiate()
	root.add_child(arena)
	current_scene = arena
	await ticks(3)
	player = arena.player
	player.combat.runner.action_started.connect(record_action)
	for career in ["warrior", "rogue", "barbarian", "mage"]:
		await prepare(career)
		verify(player.resources.pools.size() == 3 and player.resources.pools.has_all(["HP", "Stamina", "Energy"]), career + " owns one shared Energy pool with HP and stamina")
		verify(player.resources.max_value("Energy") >= 60, career + " converts its old capacity without a twenty-pip cap")
		var before: float = player.resources.current("Energy")
		verify(player.resources.pay({"Energy": 3.75}), career + " supports a fractional continuous Energy cost")
		near(player.resources.current("Energy"), before - 3.75, career + " does not round energy to discrete pips")
		var model := ViewModel.build(player, "测试")
		verify(model.resources.has("Energy") and not model.resources.has("Qi") and not model.resources.has("SpellSlot"), career + " character sheet exposes only Energy")
	for career in ["warrior", "mage"]:
		var spell_cost := 10.0 if career == "mage" else 20.0
		await prepare(career)
		if career == "warrior":
			verify(player.loadout.assign_skill(player.loadout.current_set, 0, "warrior_whirlwind"), "warrior fixture equips the authored paid Whirlwind in Q")
			verify(player.skill_at(0).get("id", "") == "warrior_whirlwind", "warrior paid-cost assertions target the equipped Q skill")
		var before: float = player.resources.current("Energy")
		await tap_key(KEY_Q)
		verify(started.size() == 1 and started[0].costs.size() == 1 and is_equal_approx(float(started[0].costs.get("Energy", -1)), spell_cost), career + " physical Q uses its authored resource cost")
		near(player.resources.current("Energy"), before - spell_cost, career + " pays its exact cost once")
		await prepare(career)
		if career == "warrior": verify(player.loadout.assign_skill(player.loadout.current_set, 0, "warrior_whirlwind"), "warrior shortfall fixture equips paid Whirlwind")
		player.resources.change("Energy", spell_cost - .25 - player.resources.current("Energy"))
		await tap_key(KEY_Q)
		verify(started.is_empty(), career + " cannot cast while a quarter point short")
		near(player.resources.current("Energy"), spell_cost - .25, career + " failed cast spends nothing")
		player.resources.change("Energy", .25)
		await tap_key(KEY_Q)
		verify(started.size() == 1, career + " can cast at the exact resource boundary")
		near(player.resources.current("Energy"), 0, career + " exact cost drains to zero")
		await prepare(career)
		player.inventory.cooldowns.clear()
		player.inventory.add_item("qi_potion", 2)
		player.inventory.add_item("spell_potion", 2)
		player.resources.change("Energy", -player.resources.current("Energy"))
		verify(player.inventory.use_item("spell_potion"), career + " uses the old small-potion inventory ID as a shared energy potion")
		near(player.resources.current("Energy"), 20, career + " small potion restores twenty energy")
		verify(player.inventory.use_item("qi_potion"), career + " uses the old large-potion inventory ID regardless of profession")
		near(player.resources.current("Energy"), 60, career + " large potion restores forty energy")
		var stock: int = player.inventory.count("qi_potion")
		player.inventory.cooldowns.clear()
		verify(not player.inventory.use_item("qi_potion") and player.inventory.count("qi_potion") == stock, career + " full energy does not consume a potion")
	await prepare("warrior")
	player.resources.change("Energy", -player.resources.current("Energy"))
	player.loadout.passive_ids.append("qi_reflux")
	player.combat.passives.trigger("perfect_dodge", player.combat.context())
	near(player.resources.current("Energy"), 20, "perfect-dodge energy reflux restores the scaled amount")
	player.combat.apply_effect({"type":"status", "status":"reversal", "duration":4, "target":"self"}, player)
	near(float(player.combat.costs_for(arena.database.skills.warrior_whirlwind).Energy), 0, "reversal waives the next weapon skill's Energy cost")
	near(float(player.combat.costs_for(arena.database.skills.mage_fireball).Energy), 10, "weapon-only reversal does not waive caster skill Energy")
	await prepare("warrior")
	player.loadout.set_level(10)
	near(player.resources.max_value("Energy"), 180, "level-ten sword profession has continuous 180-energy capacity")
	player.resources.configure("Energy", 527.5)
	verify(player.resources.pay({"Energy": .5}), "pool supports values beyond twenty pips and fractional cost")
	near(player.resources.current("Energy"), 527, "large continuous pool is not truncated to a pip count")
	player.loadout.set_level(0)
	verify(player.resources.max_value("Energy") == 0 and not player.resources.pools.has("Qi") and not player.resources.pools.has("SpellSlot"), "civilian has a valid empty Energy pool with no obsolete resource pools")
	verify(ViewModel.costs({"Energy": 12.5}) == "12.5 能量", "skill cost text exposes continuous Energy units")
	print("UNIFIED_ENERGY: %d checks; %d failures" % [checks, failures.size()])
	for failure in failures: printerr("FAIL: ", failure)
	arena.queue_free()
	await ticks(2)
	quit(0 if failures.is_empty() else 1)
