extends SceneTree

const Pips = preload("res://scripts/frontend/resource_pips.gd")
var checks := 0
var failures: Array[String] = []

func _initialize() -> void:
	call_deferred("run")

func verify(ok: bool, label: String) -> void:
	checks += 1
	if not ok:
		failures.append(label)
	print("PASS " if ok else "FAIL ", label)

func near(actual: float, expected: float, label: String) -> void:
	verify(absf(actual - expected) < 0.00001, label + " (%.5f / %.5f)" % [actual, expected])

func slot(pips: RefCounted, index: int) -> Dictionary:
	return pips.debug_state().slots[index]

func run() -> void:
	var pips := Pips.new()
	pips.update(3, 5, 0)
	verify(pips.debug_state().available_count == 3 and pips.debug_state().maximum == 5, "initial current and capacity are authoritative")
	for i in range(3):
		verify(slot(pips, i).phase == "full" and slot(pips, i).fill == 1.0 and slot(pips, i).available, "initial existing point immediately full " + str(i))
	verify(slot(pips, 3).phase == "empty" and not slot(pips, 3).available, "initial absent point empty")
	verify(not pips.is_animating(), "initial load has no fake recovery")
	var settled: Dictionary = pips.debug_state()
	pips.update(3, 5, 40)
	verify(pips.debug_state() == settled, "settled resource does not pulse or change with time")
	pips.update(1, 5, 0)
	verify(slot(pips, 0).phase == "full" and slot(pips, 1).phase == "empty" and slot(pips, 2).fill == 0.0, "spending two points extinguishes them immediately")
	pips.update(2, 5, 9)
	verify(slot(pips, 1).phase == "outline" and slot(pips, 1).outline == 0.0, "new gain starts outline at zero even after a long sample")
	verify(slot(pips, 1).available and slot(pips, 1).fill == 0.0 and pips.debug_state().available_count == 2, "real availability is separate from unfinished visual fill")
	pips.update(2, 5, .16)
	near(slot(pips, 1).outline, .5, "outline halfway at .16 seconds")
	near(slot(pips, 1).fill, 0, "outline never fills the centre early")
	pips.update(2, 5, .16)
	verify(slot(pips, 1).phase == "fill", ".32 seconds transitions from outline to fill")
	near(slot(pips, 1).outline, 1, "outline completes exactly one lap")
	near(slot(pips, 1).fill, 0, "fill starts at zero at .32 seconds")
	pips.update(2, 5, .06)
	near(slot(pips, 1).fill, .5, "fill halfway after .06 seconds")
	pips.update(2, 5, .06)
	verify(slot(pips, 1).phase == "full" and not pips.is_animating(), "recovery settles after .32 + .12 seconds")
	pips.update(5, 5, 0)
	for i in range(2, 5):
		verify(slot(pips, i).phase == "outline" and slot(pips, i).available, "simultaneous gain starts each new point independently " + str(i))
	pips.update(5, 5, .10)
	near(slot(pips, 2).outline, .3125, "first simultaneous point advances")
	near(slot(pips, 4).outline, .3125, "last simultaneous point advances together")
	pips.update(3, 5, 0)
	verify(slot(pips, 2).phase == "outline" and slot(pips, 3).phase == "empty" and slot(pips, 4).phase == "empty", "consuming cancels only spent points without restarting retained recovery")
	pips.update(3, 5, .5)
	verify(slot(pips, 2).phase == "full" and slot(pips, 3).fill == 0.0, "spent point never completes an old queued animation")
	pips.update(4, 5, 0)
	pips.update(4, 5, .36)
	verify(slot(pips, 3).phase == "fill", "large delta carries remaining time into fill")
	near(slot(pips, 3).fill, 1.0 / 3.0, "fill preserves .04 second remainder")
	pips.update(3, 5, 0)
	verify(slot(pips, 3).fill == 0.0 and slot(pips, 3).phase == "empty", "spending during fill immediately cancels the fill")
	pips.update(4, 5, 0)
	verify(slot(pips, 3).phase == "outline" and slot(pips, 3).outline == 0.0, "re-gain starts a fresh animation after interrupted fill")
	var independent := Pips.new()
	independent.update(0, 2, 0)
	independent.update(1, 2, 0)
	independent.update(1, 2, .12)
	near(slot(independent, 0).outline, .375, "second resource owns a separate animation clock")
	near(slot(pips, 3).outline, 0, "updating another resource cannot advance the first")

	var stamina := Pips.new()
	stamina.update(2, 3, 0, 0)
	verify(slot(stamina, 0).phase == "full" and slot(stamina, 2).phase == "predict", "stamina existing points full with next point bound to real timer")
	stamina.update(2, 3, .5, 1.0 / 3.0)
	near(slot(stamina, 2).outline, 1.0 / 3.0, "stamina outline follows real .5 / 1.5 seconds")
	stamina.update(2, 3, .5, 2.0 / 3.0)
	near(slot(stamina, 2).outline, 2.0 / 3.0, "stamina outline follows real 1 / 1.5 seconds")
	stamina.update(2, 3, .5, 1)
	verify(slot(stamina, 2).phase == "predict" and slot(stamina, 2).fill == 0.0 and not slot(stamina, 2).available, "completed timer without real gain remains hollow and unavailable")
	stamina.update(2, 3, 30, 1)
	verify(stamina.debug_state().available_count == 2 and slot(stamina, 2).fill == 0.0, "time alone cannot invent a stamina point")
	stamina.update(3, 3, 0, 0)
	verify(slot(stamina, 2).phase == "fill" and slot(stamina, 2).outline == 1.0 and slot(stamina, 2).available, "actual stamina gain fills directly without a second outline")
	stamina.update(3, 3, .06, 0)
	near(slot(stamina, 2).fill, .5, "predicted gain uses only the .12 second fill")
	stamina.update(3, 3, .06, 0)
	verify(slot(stamina, 2).phase == "full" and not stamina.is_animating(), "full stamina has no perpetual prediction or pulse")
	stamina.update(1, 3, 0, .7)
	verify(slot(stamina, 1).phase == "predict" and slot(stamina, 2).phase == "empty", "spending retargets only next empty point to the supplied real timer")
	stamina.update(1, 3, .1, .1)
	near(slot(stamina, 1).outline, .1, "a reset real recovery timer resets the displayed outline")
	stamina.update(0, 3, 0, 0)
	verify(slot(stamina, 0).phase == "predict" and slot(stamina, 1).phase == "empty" and slot(stamina, 2).phase == "empty", "consuming again cancels old prediction and moves to first empty point")
	stamina.update(0, 3, 10, -1)
	verify(slot(stamina, 0).phase == "empty" and not stamina.is_animating(), "removing timer cancels prediction without recovery")
	stamina.update(0, 3, 0, .4)
	stamina.update(2, 3, 0, 0)
	verify(slot(stamina, 0).phase == "fill" and slot(stamina, 1).phase == "outline" and slot(stamina, 2).phase == "predict", "multi gain completes predicted point while other new points animate independently")

	pips.clear()
	pips.update(2, 3, 0)
	pips.update(2, 5, .1)
	verify(pips.debug_state().slots.size() == 5 and slot(pips, 1).phase == "full" and slot(pips, 4).phase == "empty", "max increase preserves existing full points and adds empty capacity")
	pips.update(4, 5, 0)
	pips.update(4, 5, .16)
	pips.update(3, 3, 0)
	verify(pips.debug_state().slots.size() == 3 and slot(pips, 2).phase == "outline", "max decrease truncates removed points and preserves surviving animation")
	near(slot(pips, 2).outline, .5, "capacity change does not restart surviving recovery")
	pips.update(100, 2, 0)
	verify(pips.debug_state().current == 2 and pips.debug_state().available_count == 2 and slot(pips, 1).phase == "full", "current is safely clamped to reduced capacity")
	pips.update(2, 4, 0)
	pips.update(4, 4, 0)
	verify(slot(pips, 2).phase == "outline" and slot(pips, 3).phase == "outline", "newly gained expanded capacity uses normal gain animation")
	pips.update(0, 0, 0)
	verify(not pips.debug_state().initialized and pips.debug_state().slots.is_empty(), "zero maximum clears unavailable resource pool")
	pips.update(3, 3, 0)
	verify(slot(pips, 2).phase == "full", "a newly configured resource pool initializes instantly")
	pips.update(2.9, 3, 0)
	verify(pips.debug_state().available_count == 2 and slot(pips, 2).phase == "empty", "fractional current cannot display an unearned whole point")
	pips.update(2.99, 3, 30)
	verify(slot(pips, 2).phase == "empty", "fractional changes below next point do not fake a gain")
	pips.update(3, 3, 0)
	verify(slot(pips, 2).phase == "outline", "crossing a whole-point boundary triggers exactly one gain")
	pips.update(3, 3, -2)
	near(slot(pips, 2).outline, 0, "negative delta cannot rewind or advance animation")
	var copy: Dictionary = pips.debug_state()
	copy.slots[0].fill = 0
	verify(slot(pips, 0).fill == 1.0, "debug state is a copy and cannot mutate helper internals")
	pips.clear()
	verify(not pips.debug_state().initialized and not pips.is_animating(), "explicit clear removes every visual transition")
	# Safe no-op drawing guards need no rendering context.
	pips.draw(null, [], 4, Color.RED)
	verify(true, "missing canvas is a safe drawing no-op")
	print("RESOURCE_PIPS_RESULT checks=%d failures=%d" % [checks, failures.size()])
	quit(0 if failures.is_empty() else 1)
